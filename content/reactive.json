      "exclusiveGroup": "rest", "supersedesGroup": true },
    { "id": "shower",      "bar": "hygiene",   "below": 40, "activity": "shower",  "window": null },
    { "id": "stretch",     "bar": "movement",  "below": 35, "activity": "stretch", "window": [60, 840] }
  ]
