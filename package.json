{
  "name": "auto-life",
  "version": "0.1.0",
  "main": "index",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "serve": "^14.2.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "validate:content": "tsx scripts/validate-content.ts",
    "art:a0": "tsx scripts/art/build-a0-sheet.ts",
    "art:atlas": "tsx scripts/art/build-atlas.ts",
    "check": "npm run validate:content && npm run typecheck && npm test",
    "postinstall": "setup-skia-web public",
    "setup:skia-web": "setup-skia-web public",
    "export:web": "expo export --platform web && cp serve.json dist/serve.json",
    "serve:dist": "serve dist --listen 4173",
    "harness": "jest --runInBand --runTestsByPath src/sim/__tests__/harness/golden-week.test.ts src/sim/__tests__/harness/balance.test.ts",
    "verify": "npm run validate:content && npm run art:check && npm run audio:check && npm run art:bill && npm run typecheck && npm test && npm run export:web",
    "art:check": "npm run art:atlas && git diff --exit-code --stat -- assets/generated",
    "audio:bank": "tsx scripts/audio/build-bank.ts",
    "audio:check": "npm run audio:bank && git diff --exit-code --stat -- assets/audio",
    "art:review": "tsx scripts/art/build-review-sheet.ts",
    "art:bill": "jest --runTestsByPath src/render/__tests__/bill.test.ts"
  },
  "private": true
}
